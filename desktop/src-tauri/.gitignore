# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binary, placed here per-platform by scripts/build-sidecar.sh
# (locally) or .github/workflows/build.yml (CI). Never committed: it's a
# rebuilt-every-time PyInstaller output, and it's platform-specific (a Linux
# dev build here would be a dead file on every CI runner).
/binaries/
